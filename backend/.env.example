# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit secrets.

# Direct Postgres connection to the Supabase database (used for transactional
# adjudication writes). Find it in: Supabase Dashboard > Project Settings >
# Database > Connection string (use the URI / connection pooler value).
# Note the SQLAlchemy psycopg driver prefix: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase REST endpoint and service-role key (server-side only).
# Optional for the current phase; do not expose the service-role key to clients.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

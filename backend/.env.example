# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit secrets.

# Supabase REST endpoint and service-role key (server-side only).
# Find them in: Supabase Dashboard > Project Settings > API.
# The service-role key bypasses RLS — keep it server-side and never expose it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
